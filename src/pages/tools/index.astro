---
import Page from '../../layouts/Page.astro';
---
<Page title="Tools by Prem Poddar - web apps that run in the browser" description="Small web apps I built that you can use right here: no install, no account. Starting with a scientific calculator that only has two buttons." full absolute>
  <header class="intro">
    <h1>Tools</h1>
    <p class="lede">Things I built that you can use right here in the browser. No install, no account, nothing leaves your device.</p>
  </header>
  <section class="tools">
    <a class="tool" href="/tools/two-button-calculator/">
      <span class="icon" aria-hidden="true">¹₌</span>
      <span class="body">
        <h2>Two-Button Scientific Calculator</h2>
        <p>The machine from the Numberphile video, working: two buttons (1 and EML) that can do the whole keypad. Type an expression and watch it compile into presses.</p>
      </span>
    </a>
  </section>
</Page>

<style>
  .intro h1 { font-size: var(--step-3); }
  .lede { color: var(--muted); max-width: 56ch; margin: 0.6rem 0 2rem; }
  .tools { display: grid; gap: 1rem; max-width: 34rem; }
  .tool {
    display: flex; gap: 1rem; align-items: flex-start;
    background: var(--mat); border: 1px solid var(--mat-line); border-radius: 6px;
    padding: 1rem 1.2rem; box-shadow: var(--lift); color: inherit; text-decoration: none;
  }
  .tool:hover { border-color: var(--pen); }
  .icon { font-family: var(--mono); font-size: var(--step-2); line-height: 1; padding-top: 0.2rem; }
  .tool h2 { font-size: var(--step-0); margin: 0 0 0.3rem; }
  .tool p { margin: 0; color: var(--muted); font-size: var(--step--1); }
</style>
