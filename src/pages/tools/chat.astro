---
import Page from '../../layouts/Page.astro';
import JsonLd from '../../components/JsonLd.astro';
import { webApplicationSchema } from '../../lib/seo';

const canonical = 'https://prempoddar.is-a.dev/tools/chat/';
const claims =
  'Close the tab and everything is gone. Messages, photos and files travel directly between devices, encrypted. Nothing is stored anywhere, by us or anyone.';
---
<Page title="No-trace chat - Prem Poddar" description="A chat room that keeps nothing: close the tab and every message, photo and file is gone. Messages travel directly between devices, encrypted, and nothing is stored anywhere, by us or anyone." absolute>
  <JsonLd data={[webApplicationSchema(
    { name: 'No-trace chat', description: claims },
    canonical,
  )]} />
  <header class="intro">
    <h1>No-trace chat</h1>
    <p class="lede">{claims}</p>
  </header>

  <!--
    DOM contract for the script (scripts/chat.ts):
    - data-landing form: one submit handler. e.submitter is data-create or data-join.
      data-code is pre-filled from location.hash by the script. Enter inside data-code
      should join, so it needs its own keydown, not the form's default button.
    - data-members holds <li>Name <span class="tag">owner</span></li> entries.
    - data-requests (owner only) holds request rows:
      <p class="req-row"><span class="name">Name</span>
        <button type="button" data-accept data-userid="...">Accept</button>
        <button type="button" data-decline data-userid="...">Decline</button></p>
    - data-staged holds attachment chips waiting in the composer; Send releases text and files.
    - every message is one <li class="msg [mine]">:
        <p class="who"><b>Name</b> <time>hh:mm</time></p>
        text:   <div class="bubble">paragraphs</div>
        code:   <div class="codewrap"><pre><code></code></pre><button class="copy">Copy</button></div>
        file:   <div class="filechip">[preview per type] <div class="filecard"><span class="ficon">PDF</span>
                <div class="fmeta"><div class="fnm">Name</div><div class="fsz">size</div></div>
                <div class="fbtns"><a class="fbtn">Open (displayable types only)</a>
                <a class="fbtn">Download</a></div></div> or <progress> while moving</div>
        then (own msgs only):  <span class="ticks [read]">tick svg</span> under the bubble
  -->
  <section class="chatwrap" aria-label="No-trace chat room">
    <p class="err err-landing" data-error-landing aria-live="polite" hidden></p>

    <form class="landing" data-landing>
      <p class="hint">Pick a display name. It is the only thing this page saves, and it never leaves your browser.</p>
      <label class="field">
        <span class="visually-hidden">Display name</span>
        <input type="text" data-name maxlength="24" autocomplete="off" spellcheck="false" enterkeyhint="go" placeholder="Amber Otter" />
      </label>
      <div class="gets">
        <button type="submit" class="get" data-create>Create a room</button>
        <button type="submit" class="get ghost" data-join>Join</button>
      </div>
      <label class="codeline">
        <span>Or join with a code someone gave you</span>
        <input type="text" data-code placeholder="river-fox-tent" autocomplete="off" spellcheck="false" enterkeyhint="go" />
      </label>
    </form>

    <div class="room" data-room hidden>
      <p class="err" data-error aria-live="polite" hidden></p>
      <p class="status" data-status aria-live="polite" hidden></p>
      <div class="bar">
        <ul class="members" data-members></ul>
        <div class="bar-actions">
          <output class="linkout" data-link></output>
          <button type="button" class="ctl" data-copy-link>Copy link</button>
          <button type="button" class="ctl" data-leave>Leave</button>
        </div>
      </div>
      <div class="requests" data-requests hidden></div>
      <ul class="msgs" data-msgs role="log"></ul>
      <div class="composer">
        <ul class="staged" data-staged hidden></ul>
        <div class="compose-row">
          <label class="plus" for="chat-file" title="Attach photos or files, 25 MB max" aria-label="Attach photos or files, 25 MB max">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          </label>
          <input class="visually-hidden" type="file" id="chat-file" data-file />
          <textarea data-compose rows="1" aria-label="Message" placeholder="Write a message" title="Enter sends, Shift + Enter adds a line, Ctrl/Cmd + V or dropping files attaches them"></textarea>
          <button type="button" class="go" data-send aria-label="Send" title="Send (Enter)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="how" aria-label="How the chat works">
    <h2>How it works</h2>
    <ol class="steps">
      <li><b>Create and share.</b> Make a room and send its link to people. The code is three words so you can also read it out loud.</li>
      <li><b>You let people in.</b> The room owner sees who is asking to join and accepts or declines. Rooms hold up to 8 people and only work while everyone's tab is open.</li>
      <li><b>It goes device to device.</b> Messages, photos and files travel encrypted straight between browsers. BitTorrent's public introduction network makes the first handshake; it never sees message content.</li>
      <li><b>Nothing is stored.</b> No server copy, no history, no accounts. Close the tab and your copy of the conversation is gone. A file you download is the one thing that survives, because it is yours.</li>
      <li><b>The room ends with you.</b> When the last person leaves, the room is gone. Reopening the link starts a fresh one, empty, with the same code.</li>
    </ol>
  </section>
</Page>

<script>
  import { initChat } from '../../scripts/chat';
  initChat();
</script>

<style is:global>
  .intro h1 { font-size: var(--step-3); }
  .lede { color: var(--muted); max-width: 58ch; margin: 0.6rem 0 1.6rem; }

  .chatwrap { margin-top: 1rem; }
  .err { color: #a33; font-size: var(--step--1); margin: 0 0 0.6rem; }
  .status {
    background: var(--note); color: var(--note-ink); padding: 0.5rem 0.7rem;
    border-radius: 4px; font-size: var(--step--1); margin: 0 0 0.6rem;
  }
  .landing {
    max-width: 26rem; background: var(--mat); border: 1px solid var(--mat-major);
    border-radius: 12px; padding: 0.9rem; box-shadow: var(--lift);
  }
  .landing .hint { color: var(--muted); font-size: var(--step--1); margin: 0 0 0.7rem; }
  .field { display: block; }
  .field input, .codeline input {
    width: 100%; min-height: 44px; font: inherit; font-size: var(--step-0);
    border: 1px solid var(--mat-major); border-radius: 8px; padding: 0 0.7rem; background: var(--paper);
  }
  .gets { display: flex; gap: 0.5rem; margin-top: 0.7rem; }
  .get {
    flex: 1; min-height: 44px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper);
    border-radius: 8px; padding: 0 1.1rem; font: inherit; cursor: pointer;
  }
  .get:hover { background: var(--pen); border-color: var(--pen); }
  .get.ghost { background: var(--paper); color: var(--ink); border-color: var(--mat-major); }
  .get.ghost:hover { border-color: var(--pen); }
  .codeline { display: block; margin-top: 0.8rem; font-size: var(--step--1); color: var(--muted); }
  .codeline input { margin-top: 0.3rem; }

  .room { display: flex; flex-direction: column; gap: 0.6rem; }
  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
    background: var(--mat); border: 1px solid var(--mat-major); border-radius: 12px; padding: 0.5rem 0.8rem;
  }
  .members { list-style: none; display: flex; flex-wrap: wrap; gap: 0.2rem 0.9rem; margin: 0; padding: 0; }
  .members li { font-size: var(--step--1); }
  .members .tag {
    color: var(--muted); font-size: 0.66rem; border: 1px solid var(--paper-edge);
    border-radius: 3px; padding: 0 0.3rem; margin-left: 0.25rem;
  }
  .bar-actions { display: flex; align-items: center; gap: 0.4rem; flex: none; }
  .linkout {
    max-width: 14rem; font-family: var(--mono); font-size: var(--step--1); color: var(--muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .bar .ctl { min-height: 40px; padding: 0.2rem 0.7rem; }

  .requests {
    border: 1px dashed var(--pen); background: var(--note); color: var(--note-ink);
    border-radius: 8px; padding: 0.6rem 0.8rem; font-size: var(--step--1);
  }
  .req-title { margin: 0; font-weight: 600; }
  .req-row { display: flex; align-items: center; gap: 0.5rem; margin: 0.4rem 0 0; }
  .req-row .name { flex: 1; overflow-wrap: anywhere; }
  .req-row button {
    min-height: 34px; border-radius: 6px; font: inherit; font-size: var(--step--1); cursor: pointer;
    padding: 0 0.7rem; border: 1px solid var(--ink); background: var(--ink); color: var(--paper);
  }
  .req-row button:hover { background: var(--pen); border-color: var(--pen); }
  .req-row [data-decline] { background: var(--paper); color: var(--ink); border-color: var(--mat-major); }

  .msgs {
    list-style: none; margin: 0; padding: 1rem; flex: 1 1 auto; min-height: 0; overflow-y: auto;
    background: var(--mat); border: 1px solid var(--paper-edge); border-radius: 8px; scrollbar-width: thin;
  }
  .msgs li { margin-bottom: 0.7rem; }
  .msg { display: flex; flex-direction: column; align-items: flex-start; position: relative; }
  .msg.mine { align-items: flex-end; }
  .msg .who { font-size: var(--step--1); color: var(--muted); margin: 0 0 0.2rem; }
  .msg .who b { color: var(--ink); font-weight: 600; }
  .msg .who time { font-size: 0.68rem; }
  .msg .bubble {
    background: var(--paper); border: 1px solid var(--paper-edge); border-radius: 14px;
    border-bottom-left-radius: 4px;
    padding: 0.5rem 0.75rem; overflow-wrap: anywhere; white-space: pre-wrap; margin: 0;
    max-width: min(38rem, 82%);
  }
  .msg.mine .bubble {
    background: var(--ink); border-color: var(--ink); color: var(--paper);
    border-bottom-left-radius: 14px; border-bottom-right-radius: 4px;
  }
  .msg.mine .bubble a { color: inherit; }
  .msg p + p { margin-top: 0.35rem; }
  .codewrap { position: relative; max-width: min(38rem, 82%); }
  .codewrap pre {
    font-family: var(--mono); font-size: var(--step--1); background: var(--ink); color: #b8f5c9;
    padding: 0.6rem 4.2rem 0.6rem 0.7rem; border-radius: 6px; overflow-x: auto; margin: 0;
  }
  .codewrap pre code { font-family: inherit; color: inherit; background: none; padding: 0; }
  .codewrap .copy {
    position: absolute; top: 0.3rem; right: 0.3rem; font-family: var(--mono); font-size: 0.66rem;
    background: rgba(255, 255, 255, 0.14); color: #b8f5c9; border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 3px; cursor: pointer; padding: 0.1rem 0.4rem;
  }
  .filechip {
    font-family: var(--mono); font-size: var(--step--1);
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.25rem;
    max-width: min(24rem, 100%);
  }
  .filechip .thumb {
    width: 11rem; height: 11rem; object-fit: cover; border-radius: 10px; display: block;
    border: 1px solid var(--paper-edge);
  }
  .filechip .fname { display: block; }
  .filechip .pdfview { width: min(24rem, 100%); height: 11rem; border: 1px solid var(--paper-edge); border-radius: 10px; background: var(--paper); }
  .filechip .vidview { max-width: min(24rem, 100%); max-height: 14rem; border-radius: 10px; display: block; }
  .filechip audio { width: min(24rem, 100%); }
  .filechip .txtprev {
    font-family: var(--mono); font-size: var(--step--1); color: var(--ink); background: var(--paper);
    border: 1px solid var(--paper-edge); border-radius: 10px; padding: 0.5rem 0.6rem; margin: 0;
    max-height: 9rem; overflow: hidden; white-space: pre-wrap; max-width: min(24rem, 100%);
  }
  .filecard {
    display: flex; align-items: center; gap: 0.5rem; max-width: 24rem;
    background: var(--paper); border: 1px solid var(--paper-edge); border-radius: 10px; padding: 0.4rem 0.5rem;
  }
  .filecard .ficon {
    width: 2.6rem; height: 2.6rem; flex: none; display: grid; place-items: center;
    background: var(--mat); border: 1px solid var(--paper-edge); border-radius: 8px;
    font: 600 0.58rem var(--mono); color: var(--muted);
  }
  .filecard .fmeta { flex: 1; min-width: 0; }
  .filecard .fnm { font-family: var(--mono); font-size: var(--step--1); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .filecard .fsz { color: var(--muted); font-size: 0.66rem; }
  .filecard .fbtns { display: flex; gap: 0.3rem; flex: none; }
  .filecard .fbtn {
    border: 1px solid var(--paper-edge); background: var(--paper); border-radius: 6px;
    padding: 0.2rem 0.55rem; font-size: var(--step--1); cursor: pointer;
  }
  .filecard .fbtn:hover { border-color: var(--pen); }
  .filechip progress { width: 100%; height: 8px; accent-color: var(--pen); max-width: 92%; display: block; }
  /* Ticks hang just below the bubble's right corner instead of taking a line. */
  .msg .ticks { display: inline-flex; margin: 0; position: absolute; right: 0; bottom: -0.75rem; }
  .msg .ticks svg { width: 1.05rem; height: 0.72rem; }
  .msg .ticks path {
    fill: none; stroke: var(--muted); stroke-width: 1.7;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .msg .ticks.read path { stroke: #34b7f1; }

  .staged {
    list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem;
    margin: 0 0 0.5rem; padding: 0;
  }
  .staged li {
    display: flex; align-items: center; gap: 0.4rem; padding: 0.3rem 0.35rem 0.3rem 0.3rem;
    border: 1px solid var(--paper-edge); border-radius: 8px; background: var(--paper);
    font-size: var(--step--1);
  }
  .staged img { width: 2.75rem; height: 2.75rem; object-fit: cover; border-radius: 4px; display: block; }
  .staged .nm { max-width: 11rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .staged .drop {
    border: 0; background: none; font: inherit; cursor: pointer; color: var(--muted);
    padding: 0 0.25rem; min-height: 24px;
  }
  .staged .drop:hover { color: #a33; }
  /* One compact bar: + attach, the message field, send. Shortcut details live
     in the tooltips so nothing here costs a line of chat height. */
  .compose-row { display: flex; gap: 0.45rem; align-items: flex-end; }
  .composer .plus, .composer .go {
    flex: none; width: 2.7rem; height: 2.7rem; border-radius: 50%;
    border: 1px solid var(--mat-major); background: var(--paper); color: var(--ink);
    display: grid; place-items: center; cursor: pointer; padding: 0; font: inherit;
  }
  .composer .plus:hover, .composer .go:hover { border-color: var(--pen); }
  .composer svg { width: 1.25rem; height: 1.25rem; display: block; }
  .composer .go { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .composer .go:hover { background: var(--pen); border-color: var(--pen); }
  .composer textarea {
    flex: 1; min-width: 0; min-height: 2.7rem; max-height: 9rem; font: inherit; font-size: var(--step-0);
    border: 1px solid var(--mat-major); border-radius: 1.35rem; padding: 0.55rem 0.85rem;
    background: var(--paper); resize: none; field-sizing: content;
  }

  .how { margin-top: 2.2rem; max-width: 42rem; }
  .how h2 { font-size: var(--step-1); }
  .steps { padding-left: 1.2rem; }
  .steps li { margin-bottom: 0.55rem; color: var(--muted); line-height: 1.5; }
  .steps b { color: var(--ink); }

  /* In a room the chat takes the whole page; everything else steps aside. */
  body[data-chat-view='room'] .intro,
  body[data-chat-view='room'] .landing,
  body[data-chat-view='room'] .how { display: none; }
  body[data-chat-view='room'] .chatwrap { margin-top: 0; }
</style>
<style is:global>
  /* Chat room wants the near-full-width sheet while it is open, with as
     little chrome above the panel as possible. */
  body[data-chat-view='room'] main.sheet {
    max-width: 74rem;
    margin: 0.5rem auto 0;
    padding: 0.6rem clamp(0.8rem, 2vw, 1.5rem) 0.4rem;
  }

  @media (max-width: 640px) {
    .bar { flex-wrap: wrap; }
    .linkout { max-width: 10rem; }
    .bubble, .codewrap { max-width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .msgs { scroll-behavior: auto; }
  }
</style>
