---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import AppShowcase from '../../components/AppShowcase.astro';
import { byOrder } from '../../lib/content';

const apps = byOrder(await getCollection('apps'));
const phone = apps.filter((a) => a.data.platform.includes('android'));
const mac = apps.filter((a) => a.data.platform.includes('macos'));
const openSource = apps.length;
---
<Page title="Apps by Prem Poddar - Android, macOS and Web apps" description="Seven apps for Android, macOS and the web: CaffeinateCat, Brewlight, OAF, Loadstone, Duet, LibreChat and Campfire." full absolute>
  <header class="intro">
    <h1>Apps</h1>
    <p class="lede">Things I built because I wanted them to exist. Every one is free, with no ads and no account to sign up for. Click any card to open the app's own site.</p>
    <ul class="facts">
      <li><strong>{apps.length}</strong> apps</li>
      <li><strong>{phone.length}</strong> for Android</li>
      <li><strong>{mac.length}</strong> for macOS</li>
      <li><strong>{openSource}</strong> with public source</li>
    </ul>
  </header>

  <div class="grid">
    {apps.map((app, i) => <AppShowcase app={app} hero={i === 0} />)}
  </div>
</Page>

<style>
  .intro { max-width: 46rem; margin: 1rem 0 2.5rem; }
  h1 { font-size: var(--step-4); font-stretch: 125%; font-weight: 800; line-height: 0.95; }
  .lede { font-size: var(--step-1); line-height: 1.45; color: var(--muted); margin: 1rem 0 1.4rem; }
  .facts { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0; }
  .facts li { background: var(--paper); border: 1px solid var(--paper-edge); border-radius: 999px; padding: 0.3rem 0.9rem; font-size: 0.92rem; color: var(--muted); }
  .facts strong { color: var(--ink); font-stretch: 115%; margin-right: 0.2rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr)); gap: 1.6rem; }
</style>
