---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Related from '../../components/Related.astro';
import { publishedPosts } from '../../lib/content';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection('writing'), import.meta.env.PROD);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const date = d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Page title={d.title} description={d.description}>
  <p class="meta">
    <span class="kind">{d.kind === 'guide' ? 'Guide' : 'Post'}</span>
    <time datetime={d.date.toISOString()}>{date}</time>
    {d.draft && <span class="draft">Draft, not public</span>}
  </p>
  <h1>{d.title}</h1>
  <p class="desc">{d.description}</p>
  <article class="prose"><Content /></article>
  <Related ids={d.related} />
</Page>

<style>
  .meta { display: flex; gap: 0.8rem; align-items: center; margin: 0 0 0.6rem; color: var(--muted); font-size: var(--step--1); }
  .kind { background: var(--pen-soft); color: var(--pen); padding: 0.05rem 0.55rem; border-radius: 999px; }
  .draft { background: var(--note); color: var(--note-ink); padding: 0.05rem 0.55rem; border-radius: 4px; }
  h1 { font-size: var(--step-3); }
  .desc { font-size: var(--step-1); line-height: 1.45; color: var(--muted); margin: 1rem 0 2rem; }
</style>
