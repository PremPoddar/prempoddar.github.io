---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  wide?: boolean;
  full?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  absolute?: boolean;
}
const { title, description, wide = false, full = false, ogImage, ogType, publishedTime, ogImageWidth, ogImageHeight, absolute } = Astro.props;
---
<Base title={title} description={description} ogImage={ogImage} ogType={ogType} publishedTime={publishedTime} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight} absolute={absolute}>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main" class:list={[full ? 'full' : 'sheet', { wide }]}>
    <slot />
  </main>
  <Footer />
</Base>

<style>
  .sheet {
    position: relative;
    max-width: 46rem;
    margin: 1rem auto 0;
    background: var(--paper);
    border: 1px solid var(--paper-edge);
    border-radius: 6px;
    box-shadow: var(--lift-high);
    padding: clamp(1.4rem, 5vw, 3.2rem);
  }
  .sheet.wide { max-width: 62rem; }
  .full { max-width: 74rem; margin: 0 auto; padding: 0 1rem; }
  @media (max-width: 48rem) {
    .sheet { margin: 0.5rem 0.75rem 0; }
  }
</style>
