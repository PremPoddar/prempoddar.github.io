---
const links = [
  { href: '/', label: 'Home' },
  { href: '/apps/', label: 'Apps' },
  { href: '/work/', label: 'Work' },
  { href: '/writing/', label: 'Writing' },
  { href: '/toolbox/', label: 'Toolbox' },
  { href: '/resume/', label: 'Resume' },
];
const path = Astro.url.pathname;
---
<header class="topbar">
  <a class="home" href="/">Prem Poddar</a>
  <nav aria-label="Main">
    <ul>
      {links.map((l) => (
        <li><a href={l.href} aria-current={(l.href === '/' ? path === '/' : path.startsWith(l.href)) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .topbar {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
    max-width: 74rem; margin: 0 auto; padding: 1.1rem 1rem;
  }
  .home { font-weight: 750; font-stretch: 118%; color: var(--ink); text-decoration: none; font-size: 1.05rem; }
  ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  nav a {
    display: block; padding: 0.35rem 0.7rem; border-radius: 999px; color: var(--ink); text-decoration: none;
    font-size: var(--step--1);
  }
  nav a:hover { background: var(--paper); }
  nav a[aria-current='page'] { background: var(--ink); color: var(--paper); }

  /* Phones: name on its own line, all six links on one row underneath. On the narrowest
     phones the row scrolls sideways instead of wrapping. */
  @media (max-width: 40rem) {
    .topbar { flex-direction: column; align-items: stretch; gap: 0.6rem; padding: 0.9rem 1rem 0.6rem; }
    nav { min-width: 0; overflow-x: auto; scrollbar-width: none; margin: 0 -0.25rem; }
    nav::-webkit-scrollbar { display: none; }
    ul { flex-wrap: nowrap; justify-content: space-between; gap: 0; }
    nav a { padding: 0.45rem clamp(0.3rem, 1.6vw, 0.6rem); font-size: clamp(0.8rem, 3.6vw, 0.9rem); white-space: nowrap; }
    nav a:hover { background: transparent; }
    nav a[aria-current='page']:hover { background: var(--ink); }
  }
</style>
