---
const links = [
  { href: '/', label: 'Home' },
  { href: '/apps/', label: 'Apps' },
  { href: '/work/', label: 'Work' },
  { href: '/writing/', label: 'Writing' },
  { href: '/toolbox/', label: 'Toolbox' },
  { href: '/resume/', label: 'Resume' },
];
const path = Astro.url.pathname;
---
<header class="topbar">
  <a class="home" href="/">Prem Poddar</a>
  <nav aria-label="Main">
    <ul>
      {links.map((l) => (
        <li><a href={l.href} aria-current={(l.href === '/' ? path === '/' : path.startsWith(l.href)) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .topbar {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
    max-width: 74rem; margin: 0 auto; padding: 1.1rem 1rem;
  }
  .home { font-weight: 750; font-stretch: 118%; color: var(--ink); text-decoration: none; font-size: 1.05rem; }
  ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  nav a {
    display: block; padding: 0.35rem 0.7rem; border-radius: 999px; color: var(--ink); text-decoration: none;
    font-size: var(--step--1);
  }
  nav a:hover { background: var(--paper); }
  nav a[aria-current='page'] { background: var(--ink); color: var(--paper); }
</style>
