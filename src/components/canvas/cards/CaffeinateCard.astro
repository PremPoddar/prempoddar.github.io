<div class="caffeinate" data-caffeinate data-state="asleep">
  <svg class="cat" viewBox="0 0 120 80" aria-hidden="true">
    <path d="M20 70 Q20 30 60 30 Q100 30 100 70 Z" fill="#2b2622" />
    <path d="M30 40 L28 16 L46 32 Z M90 40 L92 16 L74 32 Z" fill="#2b2622" />
    <g class="eyes-open"><circle cx="47" cy="52" r="6" fill="#f2c14e" /><circle cx="73" cy="52" r="6" fill="#f2c14e" /><rect x="45.5" y="47" width="3" height="10" rx="1.5" fill="#2b2622" /><rect x="71.5" y="47" width="3" height="10" rx="1.5" fill="#2b2622" /></g>
    <g class="eyes-shut" stroke="#f2c14e" stroke-width="3" stroke-linecap="round" fill="none"><path d="M41 53 Q47 57 53 53" /><path d="M67 53 Q73 57 79 53" /></g>
    <text class="zz" x="96" y="22" font-size="14" fill="#56655b">z z</text>
  </svg>
  <div>
    <button type="button" role="switch" aria-checked="false" data-toggle>
      <span class="track"><span class="thumb"></span></span>
      Keep this screen awake
    </button>
    <p class="status" aria-live="polite" data-status>Off. Your screen will sleep as usual.</p>
  </div>
</div>

<script>
  import { createWakeLock } from '../../../lib/cards/wakelock';

  for (const root of document.querySelectorAll<HTMLElement>('[data-caffeinate]')) {
    const button = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const lock = createWakeLock(navigator as any, document);
    const show = (on: boolean, msg: string) => {
      button.setAttribute('aria-checked', String(on));
      root.dataset.state = on ? 'awake' : 'asleep';
      status.textContent = msg;
    };
    button.addEventListener('click', async () => {
      if (button.getAttribute('aria-checked') === 'true') {
        await lock.off();
        show(false, 'Off. Your screen will sleep as usual.');
      } else if (!lock.supported) {
        show(false, "This browser can't keep the screen awake. The Mac app can.");
      } else if (await lock.on()) {
        show(true, 'On. This screen stays awake while the page is open.');
      } else {
        show(false, "Your browser didn't allow it here. The Mac app doesn't need to ask.");
      }
    });
  }
</script>

<style>
  .caffeinate { display: flex; gap: 0.9rem; align-items: center; margin: 0 0 0.8rem; }
  .cat { width: 96px; flex: none; }
  .eyes-open { display: none; }
  [data-state='awake'] .eyes-open { display: inline; }
  [data-state='awake'] .eyes-shut, [data-state='awake'] .zz { display: none; }
  button {
    display: flex; align-items: center; gap: 0.6rem; font: inherit; font-size: 0.92rem; font-weight: 600;
    background: none; border: 0; padding: 0.2rem 0; color: var(--ink); cursor: pointer; text-align: left;
  }
  .track { flex: none; width: 2.6rem; height: 1.5rem; border-radius: 999px; background: #c7cfc9; position: relative; transition: background 150ms; }
  .thumb { position: absolute; top: 3px; left: 3px; width: calc(1.5rem - 6px); height: calc(1.5rem - 6px); border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / 0.3); transition: transform 150ms; }
  button[aria-checked='true'] .track { background: #e8a15a; }
  button[aria-checked='true'] .thumb { transform: translateX(1.1rem); }
  .status { margin: 0.3rem 0 0; font-size: 0.82rem; color: var(--muted); line-height: 1.35; }
</style>
