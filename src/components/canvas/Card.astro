---
interface Props {
  id: string;
  x: number;
  y: number;
  w: number;
  rotate?: number;
  kind: string;
  zone?: string;
  label: string;
  accent?: string;
}
const { id, x, y, w, rotate = 0, kind, zone, label, accent } = Astro.props;
---
<article
  class:list={['card', `card-${kind}`]}
  data-card={id}
  data-zone={zone}
  aria-label={label}
  style={`--x:${x}px;--y:${y}px;--w:${w}px;--r:${rotate}deg;${accent ? `--accent:${accent};` : ''}`}
>
  <slot />
</article>

<style>
  .card {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--paper-edge);
    border-radius: 10px;
    box-shadow: var(--lift);
    padding: 1.1rem 1.2rem;
  }
  @media (min-width: 900px) {
    :global(.js) .card {
      position: absolute;
      left: var(--x);
      top: var(--y);
      width: var(--w);
      transform: rotate(var(--r));
    }
    :global(.js) .card:focus-within { box-shadow: var(--lift-high); }
  }
</style>
