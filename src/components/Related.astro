---
import { resolveRelated } from '../lib/links';
interface Props { ids: string[] }
const items = await resolveRelated(Astro.props.ids);
const kindLabel = { app: 'App', work: 'Client work', writing: 'Writing' } as const;
---
{items.length > 0 && (
  <aside class="related">
    <h2>Connected on the desk</h2>
    <ul>
      {items.map((i) => (
        <li><a href={i.href}>{i.title}</a> <span>{kindLabel[i.kind]}</span></li>
      ))}
    </ul>
  </aside>
)}

<style>
  .related { margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px dashed var(--mat-major); }
  h2 { font-size: var(--step-0); margin-bottom: 0.6rem; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.4rem; }
  span { color: var(--muted); font-size: var(--step--1); margin-left: 0.4rem; }
</style>
